# Copy this file to .env and fill in your Supabase project's config to make
# Dashboard edits save live for every visitor. Without these, the site runs
# fine in "demo mode" — content is stored in each visitor's own browser.
#
# Get these values from: Supabase dashboard → Project Settings → API →
# Project URL and anon public key.
#
# You'll also need the two tables this site relies on — run
# supabase-schema.sql (repo root) once in your project's SQL Editor
# (Dashboard → SQL Editor → New query → paste the file → Run). It also sets
# permissive row-level security policies matching this site's "no password"
# choice (see README.md — anyone with the link can edit content).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Powers the "Future event added/updated" email notification
# (netlify/functions/notify-future-event.js). Sends via Gmail's SMTP
# server using the site owner's own Gmail account:
#   GMAIL_USER            — the sending Gmail address, e.g. you@gmail.com
#   GMAIL_APP_PASSWORD    — a 16-character App Password (NOT your normal
#                            Gmail password). Generate one at
#                            https://myaccount.google.com/apppasswords
#                            (requires 2-Step Verification to be turned on
#                            for the account first).
# Deliberately NOT prefixed with VITE_ — must only ever be readable
# server-side (Netlify env vars), never bundled into the browser build.
# Only takes effect on the deployed Netlify site; `npm run dev` has no
# function runtime to call it.
GMAIL_USER=
GMAIL_APP_PASSWORD=
