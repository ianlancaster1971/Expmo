# Copy this file to .env and fill in your Firebase project's config to make
# Dashboard edits save live for every visitor. Without these, the site runs
# fine in "demo mode" — content is stored in each visitor's own browser.
#
# Get these values from: Firebase console → Project settings → General →
# "Your apps" → Web app → SDK setup and configuration → Config.
#
# You'll also need a Firestore database (Firebase console → Build →
# Firestore Database → Create database), with rules that allow the public
# read/write this site's Dashboard relies on (see README.md — remember this
# means anyone with the link can edit content, matching the "no password"
# choice made for this site).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
